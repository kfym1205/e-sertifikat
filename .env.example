# ==============================================================
# KONFIGURASI ENVIRONMENT - SERTIFIKAT OTOMATIS
# ==============================================================

# URL Base aplikasi (misal: https://sertifikat-otomatis.vercel.app atau http://localhost:3000)
APP_BASE_URL="http://localhost:3000"
VITE_APP_BASE_URL="http://localhost:3000"

# --------------------------------------------------------------
# 1. INTEGRASI EMAIL SATKER BNN (webmail.bnn.go.id)
# --------------------------------------------------------------
# Pilihan provider: "bnn_smtp" | "bnn_relay_api" | "resend" | "simulation"
BNN_EMAIL_PROVIDER="bnn_smtp"

# --- OPSI A: SMTP RESMI BNN (Jika port & kredensial dibuka admin pusat) ---
# Alamat server SMTP resmi yang diberikan oleh Pusdatin/Admin Pusat BNN
# Catatan: Jangan mengasumsikan hostname webmail otomatis menjadi host SMTP.
BNN_SMTP_HOST="mail.bnn.go.id"
# Port SMTP: 465 (SSL/TLS) atau 587 (STARTTLS). Hindari port 25 (diblokir penyedia cloud/Vercel).
BNN_SMTP_PORT=465
# Bernilai true untuk port 465 (SSL), false untuk port 587 (STARTTLS)
BNN_SMTP_SECURE=true
# Alamat email resmi satker BNN
BNN_SMTP_USER="bnnkab_gorontalo@bnn.go.id"
# Password email / Application Password resmi dari Pusdatin BNN (TIDAK PERNAH DIUNGGAH KE GIT)
BNN_SMTP_PASS="rahasia_kata_sandi_resmi_satker"
# Nama dan alamat pengirim pada header email
BNN_EMAIL_FROM="BNN Kabupaten Gorontalo <bnnkab_gorontalo@bnn.go.id>"

# --- OPSI B: API RELAY RESMI BNN (Rekomendasi untuk deployment Vercel jika SMTP diblokir) ---
# Endpoint REST API relay resmi yang disetujui Administrator Pusat BNN
BNN_RELAY_ENDPOINT="https://api-mail.bnn.go.id/v1/send"
BNN_RELAY_KEY="bnn_relay_api_token_here"

# --------------------------------------------------------------
# 2. PENYEDIA EMAIL CADANGAN TERSETUJUI (RESEND API)
# --------------------------------------------------------------
# Digunakan jika disetujui sebagai relay sekunder
RESEND_API_KEY="re_123456789_abcdefg"
EMAIL_FROM="Sertifikat Panitia BNN <sertifikat@domainanda.com>"

# --------------------------------------------------------------
# 3. SUPABASE POSTGRESQL & AUTH
# --------------------------------------------------------------
# Dapatkan dari Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Webhook secret (Opsional)
WEBHOOK_SECRET="whsec_sample_secret_key"

# Kredensial Admin Bawaan
ADMIN_DEFAULT_EMAIL="admin@sertifikat.id"
ADMIN_DEFAULT_PASSWORD="admin_sertifikat_2026"
