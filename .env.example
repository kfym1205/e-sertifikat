# --------------------------------------------------------------
# 1. PENGIRIMAN EMAIL RESMI GMAIL API (OAUTH 2.0)
# --------------------------------------------------------------
# Pengiriman email dilakukan langsung melalui Gmail API resmi menggunakan akun Google yang
# dihubungkan oleh Administrator pada menu Pengaturan Email (OAuth 2.0 direct).
# Tidak memerlukan variabel SMTP atau password email satker.
#
# Izin OAuth yang diminta: https://www.googleapis.com/auth/gmail.send
#
# Nama tampilan default pengirim pada email sertifikat (opsional):
GMAIL_SENDER_NAME="e-Sertifikat BNN Kabupaten Gorontalo"
# Alamat email akun Google yang telah dihubungkan (opsional untuk pre-fill):
GMAIL_SENDER_EMAIL="sertifikat.bnnkgorontalo@gmail.com"

